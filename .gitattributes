# Guarda los archivos de texto con LF (formato Linux), aunque tu Git tenga autocrlf=true.
# Sin esto, un script con CRLF falla dentro del contenedor con "bad interpreter".
* text=auto eol=lf

# Los scripts nativos de Windows necesitan CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Archivos binarios (Git no los toca):
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.xlsx  binary
*.woff  binary
*.woff2 binary