# Configuración de Produccion de Laravel.
APP_NAME="Examen TAP Terminal"
APP_ENV=production
# Genera una con: docker compose exec api php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
# Local: http://localhost:8090/examen-tapterminal · VPS: https://ianmartinez.dev/examen-tapterminal
APP_URL=http://localhost:8090/examen-tapterminal

# Los logs van a la salida estándar: se consultan con "docker compose logs api".
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mongodb
MONGODB_URI=mongodb://app_user:cambia_esta_clave_app@mongo:27017/examen_tapterminal?authSource=examen_tapterminal
MONGODB_DATABASE=examen_tapterminal

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Un origen es protocolo + dominio + puerto, sin la subruta.
CORS_ALLOWED_ORIGINS=http://localhost:8090
L5_SWAGGER_GENERATE_ALWAYS=false

# Administrador inicial (php artisan db:seed). Sin correo o contraseña, no se crea.
ADMIN_NAME="Administrador"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Minutos que dura un token de sesión (8 h por defecto).
SANCTUM_EXPIRATION=480
